{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "eos guard hook",
        "matcher": "Write|StrReplace|Delete|ApplyPatch|EditNotebook|Shell|run_terminal_cmd|Bash|CallDynamicTool",
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": "eos guard hook --shell",
        "failClosed": true
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "eos guard hook --mcp",
        "failClosed": true
      }
    ]
  }
}
